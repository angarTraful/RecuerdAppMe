# Puerto del servidor (Render lo asigna automáticamente)
PORT=4000

# Clave Maestra del SuperAdmin para acceder a la raíz (#/) y crear/eliminar eventos
MASTER_PASSCODE=admin2026

# Credenciales de Spotify Web API (opcional para buscador mundial de canciones y carátulas)
# Obtenlas gratis en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

